# PasoBet - Variables de Entorno de Producción

# ==========================================
# BACKEND - Variables de Entorno
# ==========================================

# Base de datos PostgreSQL (Supabase o Railway)
DATABASE_URL="postgresql://username:password@host:5432/database"
DIRECT_URL="postgresql://username:password@host:5432/database"

# Puerto del servidor (Railway/Render lo asignan automáticamente)
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# JWT Secret (generar uno seguro)
JWT_SECRET="tu_jwt_secret_muy_seguro_aqui"

# ==========================================
# FRONTEND - Variables de Entorno
# ==========================================

# Supabase Configuration
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_anon_key_de_supabase"

# Backend API URL (URL del backend desplegado)
VITE_API_URL="https://tu-backend-url.com"

# ==========================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ==========================================

# 1. Copiar este archivo como .env (backend) y .env.production (frontend)
# 2. Llenar con valores reales de producción
# 3. NUNCA commitear archivos .env al repositorio
# 4. Usar servicios de secrets de la plataforma de hosting

# ==========================================
# SUPABASE SETUP
# ==========================================
# 1. Crear proyecto en https://supabase.com
# 2. Ir a Settings > API
# 3. Copiar Project URL y anon public key
# 4. Configurar DATABASE_URL con la connection string de Supabase

# ==========================================
# SEGURIDAD
# ==========================================
# - JWT_SECRET debe ser una cadena aleatoria de al menos 32 caracteres
# - Usar https://www.uuidgenerator.net/ o similar para generar
# - Rotar periódicamente las claves secretas