generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id       String    @id @default(uuid()) @db.Uuid
  nombre   String?
  email    String    @unique
  password String
  role     String    @default("USER")
  saldo    Decimal   @default(0) @db.Decimal(12, 2)
  creadoEn DateTime  @default(now()) @map("created_at")
  apuestas Apuesta[]

  @@map("usuarios")
}

model Feria {
  id           String        @id @default(uuid()) @db.Uuid
  nombre       String
  lugar        String
  fechaInicio  DateTime      @map("fecha_inicio")
  fechaFin     DateTime      @map("fecha_fin")
  estado       String        @default("activa")
  creadoEn     DateTime      @default(now()) @map("created_at")
  competencias Competencia[]

  @@map("ferias")
}

model CompetitionCategory {
  id           String        @id @default(uuid()) @db.Uuid
  modalidad    String
  sexo         String
  edadMin      Int           @map("edad_min")
  edadMax      Int?          @map("edad_max")
  nombre       String        @unique
  slug         String        @unique
  activa       Boolean       @default(true)
  creadoEn     DateTime      @default(now()) @map("created_at")
  competencias Competencia[]

  @@map("competition_categories")
}

model Competencia {
  id              String              @id @default(uuid()) @db.Uuid
  feriaId         String              @map("feria_id") @db.Uuid
  categoriaId     String              @map("categoria_id") @db.Uuid
  estado          String              @default("inactiva")
  creadoEn        DateTime            @default(now()) @map("created_at")
  apuestas        Apuesta[]
  categoria       CompetitionCategory @relation(fields: [categoriaId], references: [id])
  feria           Feria               @relation(fields: [feriaId], references: [id])
  participaciones Participacion[]
  pools           PoolApuestas[]

  @@unique([feriaId, categoriaId])
  @@map("competencias")
}

model Caballo {
  id              String          @id @default(uuid()) @db.Uuid
  nombre          String
  criadero        String?
  sexo            String?
  edadMeses       Int?            @map("edad_meses")
  cuotaBase       Float           @default(2.0) @map("cuota_base")
  cuotaActual     Float           @default(2.0) @map("cuota_actual")
  carrerasJugadas Int             @default(0) @map("carreras_jugadas")
  victorias       Int             @default(0)
  segundos        Int             @default(0)
  terceros        Int             @default(0)
  creadoEn        DateTime        @default(now()) @map("created_at")
  apuestas        Apuesta[]
  participaciones Participacion[]

  @@map("caballos")
}

model Participacion {
  id            String      @id @default(uuid()) @db.Uuid
  caballoId     String      @map("caballo_id") @db.Uuid
  competenciaId String      @map("competencia_id") @db.Uuid
  caballo       Caballo     @relation(fields: [caballoId], references: [id])
  competencia   Competencia @relation(fields: [competenciaId], references: [id])

  @@map("participaciones")
}

model Apuesta {
  id            String      @id @default(uuid()) @db.Uuid
  usuarioId     String      @map("usuario_id") @db.Uuid
  competenciaId String      @map("competencia_id") @db.Uuid
  caballoId     String      @map("caballo_id") @db.Uuid
  monto         Decimal     @db.Decimal(12, 2)
  cuotaTomada   Float       @default(1.0) @map("cuota_tomada")
  posiblePago   Decimal     @default(0) @map("posible_pago") @db.Decimal(12, 2)
  estado        String      @default("pendiente")
  creadoEn      DateTime    @default(now()) @map("created_at")
  caballo       Caballo     @relation(fields: [caballoId], references: [id])
  competencia   Competencia @relation(fields: [competenciaId], references: [id])
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])

  @@map("apuestas")
}

model PoolApuestas {
  id            String      @id @default(uuid()) @db.Uuid
  competenciaId String      @map("competencia_id") @db.Uuid
  caballoId     String      @map("caballo_id") @db.Uuid
  totalApostado Float       @default(0) @map("total_apostado")
  creadoEn      DateTime    @default(now()) @map("created_at")
  competencia   Competencia @relation(fields: [competenciaId], references: [id])

  @@unique([competenciaId, caballoId])
  @@map("pool_apuestas")
}
